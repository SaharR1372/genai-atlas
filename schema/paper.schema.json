{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genai-atlas/schema/paper.schema.json",
  "title": "Paper",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "title", "date", "tier", "sections", "status", "summary"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "type": { "const": "paper" },
    "title": { "type": "string", "minLength": 1 },
    "short": { "type": "string", "description": "Short/common name, e.g. RAE, FLUX.1 Kontext" },
    "arxiv": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}\\.\\d{4,5}$"
    },
    "doi": { "type": ["string", "null"] },
    "date": { "$ref": "common.schema.json#/$defs/isoDate" },
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["preprint", "workshop", "conference", "journal"]
        }
      },
      "required": ["name", "status"]
    },
    "orgs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "authors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tier": { "$ref": "common.schema.json#/$defs/tier" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/section" }
    },
    "axes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "common.schema.json#/$defs/id" }
      },
      "propertyNames": { "$ref": "common.schema.json#/$defs/axisKey" }
    },
    "lines": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/id" },
      "description": "Research line ids this paper belongs to. A paper may sit in more than one."
    },
    "problems": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/id" }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": ["string", "null"] },
        "weights": { "type": ["string", "null"] },
        "project": { "type": ["string", "null"] },
        "pdf": { "type": ["string", "null"] }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "weights", "verified"],
      "properties": {
        "code": { "$ref": "common.schema.json#/$defs/releaseStatus" },
        "weights": { "$ref": "common.schema.json#/$defs/releaseStatus" },
        "verified": { "type": "boolean" },
        "verified_on": { "type": ["string", "null"] },
        "verified_by": { "type": ["string", "null"] }
      }
    },
    "summary": { "type": "string", "minLength": 1 },
    "explanation": {
      "type": ["string", "null"],
      "description": "Path to MDX file with the full paper-page template"
    },
    "_review": {
      "type": "object",
      "description": "Pipeline review metadata. Present only on files under data/monitor/candidates/; stripped when a candidate is promoted into data/papers/.",
      "additionalProperties": true,
      "properties": {
        "score": { "type": "number" },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string" },
        "hf_upvotes": { "type": ["integer", "null"] },
        "discovered_on": { "type": "string" }
      }
    }
  }
}
