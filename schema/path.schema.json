{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genai-atlas/schema/path.schema.json",
  "title": "Learning path",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "title", "audience", "steps"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "type": { "const": "path" },
    "title": { "type": "string", "minLength": 1 },
    "audience": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "why"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
