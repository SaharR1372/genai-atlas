{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genai-atlas/schema/benchmark.schema.json",
  "title": "Benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "name", "metric", "sections"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "type": { "const": "benchmark" },
    "name": { "type": "string", "minLength": 1 },
    "metric": { "type": "string", "minLength": 1 },
    "higher_is_better": { "type": "boolean" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/section" }
    },
    "introduced_by": { "$ref": "common.schema.json#/$defs/id" },
    "notes": { "type": "string" }
  }
}
